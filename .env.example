# Django Settings
SECRET_KEY=django-insecure-replace-this-with-a-real-secure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,mylibrary_web,192.168.1.103

# Database configuration (using django-environ postgres:// schema)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# In Docker (connected to DevStack): DATABASE_URL=postgres://admin:your_password_here@postgres:5432/BookDB
# Outside Docker (local host): DATABASE_URL=postgres://admin:your_password_here@localhost:5432/BookDB
DATABASE_URL=postgres://admin:your_password_here@postgres:5432/BookDB

# Redis cache url (optional)
# In Docker: REDIS_URL=redis://default:your_password_here@redis:6379/0
# Outside Docker: REDIS_URL=redis://default:your_password_here@localhost:6379/0
REDIS_URL=redis://default:your_password_here@redis:6379/0

# API Security token for scanners
SCANNER_API_TOKEN=replace-with-scanner-api-token
AUTH_PASSWORD=replace-with-auth-password
