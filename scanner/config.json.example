{
  "server_url": "http://localhost:8000",
  "api_token": "super-secret-sync-token-12345",
  "state_db": "P:\\scanner_state.db",
  "scan_folders": [
    {
      "path": "P:\\Books",
      "type": "BOOK"
    },
    {
      "path": "P:\\Magazines",
      "type": "MAGAZINE"
    },
    {
      "path": "P:\\Audiobooks",
      "type": "AUDIOBOOK",
      "recursive": false
    },
    {
      "path": "P:\\Calibre Library",
      "type": "BOOK"
    }
  ],
  "amazon": {
    "audible_locale": "us",
    "kindle_export_file": "kindle_library.csv"
  },
  "epubmeta": {
    "enabled": true,
    "state_db": "P:\\Books_bad\\.epubmeta_state.db",
    "backup": true,
    "backup_dir": "P:\\Books_bad\\bak",
    "quarantine_dir": "P:\\Books_bad\\quarantine",
    "ignore_pdfs": true,
    "pdf_only": false,
    "pdf_require_isbn": true,
    "skip_complete": true,
    "retry_failed": false,
    "max_files": 250,
    "exclude_dirs": [
      "Computer Book Code",
      "File Formats"
    ],
    "gemini_api_key": "your_gemini_api_key_here"
  }
}
